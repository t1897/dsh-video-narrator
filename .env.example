# 复制成 .env，填入你自己的值（.env 已被 .gitignore 忽略）
# 也可以放到 ~/.vcs.env 作为全局默认

# ---- 文本阶段：agent（默认，宿主 Agent 写文件）| http（OpenAI 兼容）----
VCS_TEXT_PROVIDER=agent

# ---- 文字模型（仅 VCS_TEXT_PROVIDER=http 时需要）----
# base_url 带不带 /v1 都行，vcs 会自动探测
VCS_LLM_BASE_URL=
VCS_LLM_API_KEY=
VCS_LLM_MODEL=

# ---- 图片：默认魔搭 ModelScope（异步任务）----
# 质量档可把 model 换成 Qwen/Qwen-Image-2512
VCS_IMAGE_PROVIDER=modelscope
VCS_MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn
# 单 Key（向后兼容）
VCS_MODELSCOPE_API_KEY=
VCS_MODELSCOPE_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo

# 多账号/多 Key（配合 providers.json 使用；按顺序回退）
VCS_MODELSCOPE_CN_KEY=
VCS_MODELSCOPE_CN_KEY_2=
VCS_MODELSCOPE_INTL_KEY=

# 自定义文本 API（OpenAI 兼容，可多个按顺序回退）
VCS_LLM_1_KEY=
VCS_LLM_2_KEY=
VCS_LLM_3_KEY=

# ---- 图片：OpenAI images 兼容（可选）----
VCS_IMAGE_BASE_URL=
VCS_IMAGE_API_KEY=
VCS_IMAGE_MODEL=

# ---- 本地模型（默认 1.7B，已确认）----
VCS_ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
VCS_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16

# ---- TTS：OpenAI speech 兼容（可选）----
VCS_TTS_PROVIDER=local
VCS_TTS_BASE_URL=
VCS_TTS_API_KEY=
VCS_TTS_MODEL=
VCS_TTS_VOICE=
